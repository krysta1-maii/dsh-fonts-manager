{
  "name": "@local/dsh-fonts-manager",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "在插件详情页预览、对比并管理 DSH 正文、代码与终端字体。",
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-0 <0.2.2-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "shared.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "VERIFICATION.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.js",
    "test:browser": "node scripts/test-browser.mjs",
    "check": "node --check index.js && node --check shared.js && node --check client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
