# 根目录没有运行时依赖。该规则同时覆盖任意子目录里的安装树。
node_modules/

# 隔离的浏览器组件回归：依赖、regression.html、截图和 verification.json。
# 见 README 中的 npm install --prefix .ui-test。
.ui-test/

# 本机发布备份、已安装副本和 live host 核验记录。含本机路径，可能含 profile 字体设置。
.release-backups/

# npm pack 产物
*.tgz
.npm/

# client.js 是发布用预构建浏览器包（package.json 的 files 与 exports）。
# 用 npm run build 更新后应提交，不要忽略。

# 设计原型源码入库。截图和验证报告由 design-preview/render.mjs 再生成，报告含本机 file URL。
design-preview/font-manager-*.png
design-preview/verification.json

# 本地环境与凭据
.env
.env.*
!.env.example
*.local

# 日志、覆盖率和工具缓存
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage/
.nyc_output/
*.lcov
.eslintcache
.stylelintcache
.cache/
.parcel-cache/

# 操作系统与编辑器临时文件
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini
ehthumbs.db
*.swp
*.swo
*~
*.orig
*.rej
.idea/
.vscode/
*.code-workspace
